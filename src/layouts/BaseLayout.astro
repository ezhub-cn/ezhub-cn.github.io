---
import '../styles/tokens.css';

const navigation = [
  { href: '/products/', label: '产品' },
  { href: '/#principles', label: '品牌理念' },
];

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/"><span class="brand-mark" aria-hidden="true">E</span>EZHub</a>
        <nav class="desktop-nav" aria-label="主导航">
          {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>菜单</summary>
          <nav aria-label="主导航">
            {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <slot />
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="wordmark" href="/"><span class="brand-mark" aria-hidden="true">E</span>EZHub</a>
        <nav aria-label="页脚导航">
          {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
      </div>
    </footer>

  </body>
</html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  const summary = menu?.querySelector('summary');

  if (menu && summary) {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => { menu.open = false; });
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary.focus();
      }
    });
  }
</script>

<style>
  .skip-link {
    position: absolute;
    z-index: 2;
    inset-block-start: .5rem;
    inset-inline-start: var(--page-gutter);
    padding: .5rem 1rem;
    border-radius: .5rem;
    background: var(--color-background);
  }

  .skip-link:not(:focus) {
    clip-path: inset(50%);
  }

  .site-header {
    border-block-end: 1px solid var(--color-border);
  }

  .header-inner,
  .footer-inner,
  nav,
  .wordmark {
    display: flex;
    align-items: center;
  }

  .header-inner,
  .footer-inner {
    justify-content: space-between;
    gap: 1rem;
  }

  .header-inner,
  .footer-inner {
    min-block-size: 4.5rem;
  }

  .wordmark {
    gap: .65rem;
    color: var(--color-text);
    font-size: 1.2rem;
    font-weight: 750;
    text-decoration: none;
  }

  nav {
    flex-wrap: wrap;
    gap: .5rem clamp(.75rem, 3vw, 2rem);
  }

  nav a,
  summary {
    padding-block: .5rem;
    color: var(--color-muted);
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: .25em;
  }

  .mobile-nav {
    display: none;
  }

  .site-footer {
    border-block-start: 1px solid var(--color-border);
  }

  @media (max-width: 42rem) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
      position: relative;
    }

    summary {
      width: fit-content;
      padding-inline: .625rem;
      border: 1px solid var(--color-border);
      border-radius: .5rem;
      cursor: pointer;
    }

    .mobile-nav nav {
      position: absolute;
      z-index: 1;
      inset-block-start: calc(100% + .5rem);
      inset-inline-end: 0;
      inline-size: 8rem;
      display: grid;
      gap: 0;
      padding: .5rem .875rem;
      border: 1px solid var(--color-border);
      border-radius: .75rem;
      background: var(--color-background);
      box-shadow: 0 .5rem 1.25rem #24397e1a;
    }

    .footer-inner {
      flex-wrap: wrap;
      padding-block: 1rem;
    }
  }
</style>
