---
import BaseLayout from './BaseLayout.astro';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const name = product.alias ? `${product.name}（${product.alias}）` : product.name;
---

<BaseLayout title={`${name} · 产品详情 · EZHub`} description={`${name}：${product.description}当前状态为${product.status}。`}>
  <main class="container detail" id="main" tabindex="-1">
    <a class="back-link" href="/products/"><span aria-hidden="true">←</span> 返回产品中心</a>
    <header class="detail-hero">
      <span class="status">{product.status}</span>
      <h1>{name}</h1>
      <p>{product.description}</p>
    </header>
    <div class="detail-content">
      <slot />
    </div>
  </main>
</BaseLayout>

<style>
  .detail {
    padding-block: clamp(2rem, 5vw, 4rem) var(--page-spacing);
    overflow-wrap: anywhere;
  }

  .back-link {
    display: inline-block;
    margin-block-end: 1.5rem;
    color: var(--color-accent);
    font-weight: 650;
    text-underline-offset: .25em;
  }

  .detail-hero {
    padding: clamp(1.25rem, 5vw, 3.5rem);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, var(--color-surface), #f1edff);
  }

  .status {
    display: inline-block;
    padding: .25rem .65rem;
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    background: var(--color-background);
    color: var(--color-muted);
    font-size: .875rem;
  }

  h1 {
    margin-block: .75rem;
    font-size: clamp(2rem, 5.5vw, 4.75rem);
    line-height: 1.16;
    letter-spacing: -.035em;
  }

  .detail-hero p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  .detail-content {
    display: grid;
    gap: 1.75rem;
    max-inline-size: 46rem;
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
  }

  .detail-content :global(h2) {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
  }

  .detail-content :global(p) {
    margin-block: .5rem 0;
    color: var(--color-muted);
    text-wrap: pretty;
  }
</style>
